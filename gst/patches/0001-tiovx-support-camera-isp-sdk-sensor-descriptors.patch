 #define DEFAULT_TIOVX_LDC_TARGET TIVX_TARGET_VPAC_LDC_ID
 #define MAX_SRC_PADS 1
@@ -630,8 +633,24 @@ gst_tiovx_ldc_init_module (GstTIOVXSimo * simo,
   }
 
   if (NULL != self->dcc_config_file) {
+    GError *error = NULL;
+    CameraIspSdkSensor *camera_isp_sdk_sensor =
+        camera_isp_sdk_sensor_find (self->sensor_name, &error);
+
     ldc->ldc_mode = TIOVX_MODULE_LDC_OP_MODE_DCC_DATA;
-    status = tiovx_init_sensor (sensorObj, self->sensor_name);
+    if (NULL != camera_isp_sdk_sensor) {
+      GST_INFO_OBJECT (self, "Using sensor descriptor %s (DCC ID %d)",
+          camera_isp_sdk_sensor->path, camera_isp_sdk_sensor->dcc_id);
+      status = camera_isp_sdk_init_sensor_obj (sensorObj, self->sensor_name,
+          camera_isp_sdk_sensor->dcc_id);
+      camera_isp_sdk_sensor_free (camera_isp_sdk_sensor);
+    } else if (NULL != error) {
+      GST_ERROR_OBJECT (self, "Invalid sensor descriptor: %s", error->message);
+      g_clear_error (&error);
+      status = VX_FAILURE;
+    } else {
+      status = tiovx_init_sensor (sensorObj, self->sensor_name);
+    }
     if (VX_SUCCESS != status) {
       GST_ERROR_OBJECT (self, "tiovx init sensor error: %d", status);
       goto out;
